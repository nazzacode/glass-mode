{
  "manifest_version": 2,
  "name": "Glass Mode",
  "version": "1.0.3",
  "description": "Transparent websites: frosted, liquid-glass panels over your desktop, with readable text.",
  "browser_specific_settings": {
    "gecko": {
      "id": "transparent-zen@nazzacode",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://nazzacode.github.io/glass-mode/updates.json"
    }
  },
  "icons": {
    "48": "assets/images/logo_48.png",
    "96": "assets/images/logo_96.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    "assets/images/*.svg",
    "data/*.json",
    "styles/*"
  ],
  "browser_action": {
    "default_popup": "dist/popup/popup.html",
    "default_title": "Glass Mode"
  },
  "options_ui": {
    "page": "dist/settings/settings.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "dist/background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "dist/transparent-zen.css"
      ],
      "js": [
        "dist/transparent-zen.js"
      ],
      "run_at": "document_start",
      "exclude_matches": [
        "https://ogs.google.com/*"
      ]
    },
    {
      "matches": [
        "https://ogs.google.com/*"
      ],
      "all_frames": true,
      "css": [
        "dist/transparent-zen.css"
      ],
      "js": [
        "dist/transparent-zen.js"
      ],
      "run_at": "document_start"
    }
  ]
}